{
  "name": "seoforge-ai",
  "version": "1.0.0",
  "description": "SEOForge AI - AI SEO Blog & Content Cluster Generator",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
