# ===================================================================
# SEOForge AI - Environment Configuration Example
# ===================================================================

# Server Port (default: 5000)
PORT=5000

# Google Gemini API Key
# Optional: If omitted or left empty, SEOForge AI operates in Demo Mode
# with realistic, pre-engineered sample outputs for all workflows.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model ID (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
